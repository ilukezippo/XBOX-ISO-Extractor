<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modernized implicit RadioButton style (v2).
         Ring and dot are overlaid in a Grid so the dot is always
         perfectly centered, at any DPI. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#BBBBBB"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <!-- Outer ring -->
                            <Ellipse x:Name="ring"
                                     Stroke="#666666" StrokeThickness="2"
                                     Fill="Transparent"/>
                            <!-- Inner dot (checked indicator), centered by the Grid -->
                            <Ellipse x:Name="dot"
                                     Width="7" Height="7"
                                     Fill="#00FF7F"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="#00FF7F"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="#00FF7F"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="Stroke" Value="#00FF7F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ring" Property="Stroke" Value="#333333"/>
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

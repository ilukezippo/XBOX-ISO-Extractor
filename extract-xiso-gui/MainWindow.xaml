<Window x:Class="extract_xiso_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:extract_xiso_gui"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        ResizeMode="CanMinimize"
        Background="#121212"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="extract-xiso-gui" Height="850" Width="820">

    <Window.Resources>
        <!-- Dark TabControl / TabItem styling -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="tabBd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="#333333" Padding="10,6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBd" Property="BorderBrush" Value="#00FF7F"/>
                                <Setter Property="Foreground" Value="#00FF7F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Blur Image -->
        <Image Source="/Images/XboxBG.png" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25">
            <Image.Effect>
                <BlurEffect Radius="20"/>
            </Image.Effect>
        </Image>

        <!-- Custom Title Bar / Drag Header -->
        <Rectangle Fill="Transparent" MouseLeftButtonDown="DragWindow" Height="35" VerticalAlignment="Top"/>

        <StackPanel Cursor="Hand" Background="Transparent" MouseLeftButtonDown="OpenAbout" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <Image Source="/Images/Xbox.png" Width="140"/>
            <TextBlock Text="XBOX ISO Extractor" Foreground="White" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="For Original XBOX &amp; XBOX360" Foreground="#107C41" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Main Workspace Container Card -->
        <Border Background="#1E1E1E" CornerRadius="8" Margin="30,183,30,30" Padding="20" BorderBrush="#333333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Section: Console Tabs / Mode Select + Paths/Options -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Console Tabs, Mode Selection & Description -->
                    <Border Grid.Column="0" Background="#141414" CornerRadius="6" Padding="12" Margin="0,0,15,0" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TabControl Name="tcConsole" SelectionChanged="Console_TabChanged">
                                <TabItem Header="XBOX">
                                    <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                                        <RadioButton Name="rbExtract" Content="Extract" GroupName="ogModes" Click="SelectedMode_Changed" Margin="0,0,0,8"/>
                                        <RadioButton Name="rbCreate" Content="Create" GroupName="ogModes" Click="SelectedMode_Changed" Margin="0,0,0,8"/>
                                        <RadioButton Name="rbRewrite" Content="Rewrite" GroupName="ogModes" Click="SelectedMode_Changed" Margin="0,0,0,8"/>
                                        <RadioButton Name="rbList" Content="List" GroupName="ogModes" Click="SelectedMode_Changed" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="XBOX 360">
                                    <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                                        <RadioButton Name="rb360Extract" Content="Extract" GroupName="x360Modes" Click="SelectedMode_Changed" Margin="0,0,0,8"/>
                                        <RadioButton Name="rb360GOD" Content="Convert to GOD" GroupName="x360Modes" Click="SelectedMode_Changed" Margin="0,0,0,8"/>
                                        <RadioButton Name="rb360List" Content="List" GroupName="x360Modes" Click="SelectedMode_Changed" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <Separator Background="#333333" Margin="0,12,0,10"/>

                            <!-- Mode Description Display Box -->
                            <TextBlock Text="DESCRIPTION" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Border Background="#0A0A0A" CornerRadius="4" Padding="8" MinHeight="110">
                                <TextBlock Name="txtModeDescription" Text="Select a mode above to view details." Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Paths & Options -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Input Section -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Input Path (File or Folder)" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="InputPath" Text="" Height="32" IsReadOnly="True" AllowDrop="True" PreviewDragOver="InputPath_PreviewDragOver" PreviewDrop="InputPath_PreviewDrop" Background="#0F0F0F" Foreground="#00FF7F" BorderBrush="#333333" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" ToolTip="Drag &amp; drop ISO files or a folder here"/>
                                <Button Name="InputBrowse" Grid.Column="1" Content="Browse..." Click="InputBrowse_Click" Height="32" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Output Section -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="Output Path" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="OutputPath" Text="" Height="32" IsReadOnly="True" AllowDrop="True" PreviewDragOver="OutputPath_PreviewDragOver" PreviewDrop="OutputPath_PreviewDrop" Background="#0F0F0F" Foreground="#00FF7F" BorderBrush="#333333" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" ToolTip="Drag &amp; drop a destination folder here"/>
                                <Button Name="OutputBrowse" Grid.Column="1" Content="Browse..." Click="OutputBrowse_Click" Height="32" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Checkboxes / Switches Grid -->
                        <UniformGrid Grid.Row="2" Columns="2" Rows="3" VerticalAlignment="Top" Margin="0,5,0,0">
                            <CheckBox Name="cbDelISO" Content="Delete ISO after process" ToolTip="Deletes original .iso after a verified successful extraction/conversion." Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                            <CheckBox Name="cbAutoXBE" Content="Disable auto .xbe patching" ToolTip="Disable automatic .xbe media enable patching. (Original Xbox only)" Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                            <CheckBox Name="cbSkipSys" Content="Skip $SystemUpdate" IsChecked="True" ToolTip="Skip $SystemUpdate folder during processing." Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                            <CheckBox Name="cbTrim" Content="Trim GOD output" ToolTip="Remove unused padding when converting to GOD. Smaller output, safe for games." Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                            <CheckBox Name="cbOpenFolder" Content="Open folder on finish" IsChecked="True" ToolTip="Automatically opens the destination folder after finishing." Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                            <CheckBox Name="cbCloseApp" Content="Close app on finish" ToolTip="Automatically exits extract-xiso-gui when execution finishes." Foreground="White" VerticalAlignment="Center" Margin="0,4"/>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- Log Panel -->
                <StackPanel Grid.Row="1" Margin="0,15,0,0">
                    <TextBlock Text="LOG" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Background="#0A0A0A" CornerRadius="4" BorderBrush="#2A2A2A" BorderThickness="1">
                        <TextBox Name="txtLog"
                                 Height="170"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#B8F5D0"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Padding="8"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>

                <!-- Bottom Bar: Progress + Status + Action Button -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                        <ProgressBar Name="procProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#00FF7F" Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1"/>

                        <!-- Spinner + Status Text -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Name="spinner"
                                     Width="13" Height="13"
                                     Stroke="#00FF7F" StrokeThickness="2.5"
                                     StrokeDashArray="5,3"
                                     RenderTransformOrigin="0.5,0.5"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="spinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="spinnerRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Name="txtStatus" Text="Idle." Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Name="GoBTN" Grid.Column="1" Content="START PROCESS" Click="GoBTN_Click" Width="150" Height="42" FontWeight="Bold" FontSize="13"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Window Control Buttons -->
        <TextBlock Name="MinimizeButton" Text="_" MouseLeftButtonDown="MinimizeButton_MouseLeftButtonDown" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,45,0" Cursor="Hand"/>
        <TextBlock Name="CloseButton" Text="✕" MouseLeftButtonDown="CloseButton_MouseLeftButtonDown" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" Cursor="Hand"/>

        <!-- Download Progress Bar (tool downloads only) -->
        <ProgressBar Name="pb" Height="6" VerticalAlignment="Bottom" Foreground="#107C41" Background="#222222" Visibility="Hidden"/>
    </Grid>
</Window>

<Window x:Class="extract_xiso_gui.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:extract_xiso_gui"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        ResizeMode="NoResize"
        Title="About" Height="590" Width="520">
    <Grid>
        <Image Source="/Images/XboxBG2.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25"/>

        <StackPanel Margin="30,25,30,0" VerticalAlignment="Top">
            <TextBlock Text="XBOX ISO Extractor" Foreground="White" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="For Original XBOX &amp; XBOX360" Foreground="#00FF7F" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,15"/>

            <!-- Description Card -->
            <Border Background="#1E1E1E" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontFamily="Segoe UI" FontSize="13"
                               Text="XBOX ISO Extractor is a GUI for the command-line tools extract-xiso and iso2god. It extracts, creates, and rewrites XISOs for use in emulators or for managing game files — supporting both Original Xbox and Xbox 360 discs."/>

                    <!-- Credit to the original author -->
                    <TextBlock TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12" Margin="0,8,0,0">
                        <Run Foreground="#888888" Text="This is an updated and enhanced version of "/>
                        <Run Foreground="#00FF7F" Text="extract-xiso-gui by KilLo445" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="OpenOriginalGitHub"/>
                        <Run Foreground="#888888" Text="."/>
                    </TextBlock>

                    <Separator Background="#333333" Margin="0,12,0,10"/>

                    <TextBlock Text="FEATURES" Foreground="#00FF7F" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontFamily="Segoe UI" FontSize="12" LineHeight="19"
                               Text="•  Original Xbox: Extract, Create, Rewrite, and List modes&#x0a;•  Xbox 360: Extract to XEX folders, or convert to GOD (Games on Demand) with optional trimming&#x0a;•  Batch processing — drop in a whole folder of ISOs&#x0a;•  Drag &amp; drop ISOs or folders straight onto the path boxes&#x0a;•  Live log with real-time progress bar and cancel support&#x0a;•  Safe deletion — source ISOs are only removed after a verified successful process&#x0a;•  Remembers your last-used folders between sessions&#x0a;•  Sound notification when the queue finishes"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- GitHub logo: opens YOUR repository -->
        <Image Source="/Images/GitHub/GitHub_Logo_White.png" Width="120" VerticalAlignment="Bottom" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OpenGitHub" ToolTip="Open this project on GitHub" Margin="0,0,0,45"/>

        <CheckBox Name="cbEnableUpdates" Content="Enable updates" ToolTip="Enable/disable checking for updates on startup." Checked="cbEnableUpdates_Checked" Unchecked="cbEnableUpdates_Unchecked" VerticalAlignment="Bottom" Foreground="White" Margin="12,0,0,12"/>

        <TextBlock Name="VersionText" Text="v1.0.0" Foreground="White" Opacity="0.4" FontFamily="Segoe UI" FontSize="14" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
    </Grid>
</Window>
